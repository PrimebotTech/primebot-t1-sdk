CommonRequest header

# 播放类型: "emotion"(内置表情) 或 "video"(视频)
# 注意: 不同type之间默认无法互相打断切换，需通过更高优先级实现
string type

# 播放的机器人内置表情id，仅在type="emotion"时生效
# 必须传入有效的内置表情ID，无效ID将导致请求失败
int32[] emotion_ids

# 文件路径列表
# type="video"时: 传入设备本地视频文件绝对路径
# 注意: 必须传入有效的文件路径，无效路径将导致请求失败
string[] file_paths

# 优先级配置:
# - 系统默认表情优先级为0
# - 数字越大优先级越高
# - 同类型媒体: 高优先级可打断低优先级，同优先级可互相切换
# - 不同类型媒体: 仅当新请求优先级严格高于当前播放时才能打断
# - 建议: 表情和视频使用不同优先级以实现正常切换
int32 priority

# 整体配置的循环播放次数，大于0则播放具体次数。小于等于0，则表示循环播放 。默认值为1，表示播放一次
int32 loop_count

---

CommonResponse header